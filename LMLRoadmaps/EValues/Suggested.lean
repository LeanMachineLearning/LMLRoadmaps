/-!
# E-values, e-processes and anytime-valid inference: suggested target signatures

**This file is not the roadmap and is not exhaustive.** The definitive document is `README.md`.
The statements here suggest Lean forms for particular milestones, so that contributors and
reviewers converge on names and signatures; discharging all of them finishes neither a milestone
nor the roadmap. The admitted proofs are targets, not claimed implementations.

`IsEVar`, `effectiveSet`, `maxUtility`, `logUtility`, `klIntegral` and `∫ᵉ` are Statlib's. The
definitions of LMLExplore that the statements need (`IsPVar`, `IsCondEVar`, `IsEProcess`,
`IsEMerging`, ...) are restated here in their present form, so that this file imports only
Mathlib, LML (with Statlib) and Tau Ceti. In LMLExplore the definitions of this file live in the
namespace `ProbabilityTheory`, next to Statlib's.

Values are in `ℝ≥0∞`, nulls are sets of measures with no domination, filtrations are indexed by
`ℕ`, and conditional statements are set-integral inequalities, as the Conventions of `README.md`
pin.
-/

noncomputable section

open MeasureTheory ProbabilityTheory InformationTheory Filter Set
open scoped ENNReal NNReal Topology

namespace LMLRoadmaps.EValues

variable {Ω : Type*} {mΩ : MeasurableSpace Ω}

/-! ## Layer 0: e-variables, p-variables, tests, calibration, post-hoc validity, nulls and bets -/

/-- The image of a null by a map (Layer 0.6). -/
def mapNull {Ω' : Type*} [MeasurableSpace Ω'] (φ : Ω → Ω') (S : Set (Measure Ω)) :
    Set (Measure Ω') :=
  Measure.map φ '' S

/-- The null of `n` independent observations with one law in `S₁` (Layer 0.6). -/
def sampleNull {𝓧 : Type*} [MeasurableSpace 𝓧] (S₁ : Set (Measure 𝓧)) (n : ℕ) :
    Set (Measure (Fin n → 𝓧)) :=
  (fun P ↦ Measure.pi fun _ : Fin n ↦ P) '' S₁

/-- The null of an i.i.d. sequence with law in `S₁` (Layer 0.6). -/
def iidNull {𝓧 : Type*} [MeasurableSpace 𝓧] (S₁ : Set (Measure 𝓧)) : Set (Measure (ℕ → 𝓧)) :=
  (fun P ↦ Measure.infinitePi fun _ : ℕ ↦ P) '' S₁

/-- The null of independent observations, each with a law in `S₁` (Layer 0.6). -/
def indepNull {𝓧 : Type*} [MeasurableSpace 𝓧] (S₁ : Set (Measure 𝓧)) : Set (Measure (ℕ → 𝓧)) :=
  Measure.infinitePi '' {P : ℕ → Measure 𝓧 | ∀ i, P i ∈ S₁}

theorem iidNull_subset_indepNull {𝓧 : Type*} [MeasurableSpace 𝓧] (S₁ : Set (Measure 𝓧)) :
    iidNull S₁ ⊆ indepNull S₁ := by
  rintro _ ⟨P, hP, rfl⟩
  exact ⟨fun _ ↦ P, fun _ ↦ hP, rfl⟩

/-- The e-variables for the image of a null are the bets whose composition is an e-variable
(Layer 0.6). -/
theorem isEVar_mapNull_iff {Ω' : Type*} [MeasurableSpace Ω'] {φ : Ω → Ω'} (hφ : Measurable φ)
    {S : Set (Measure Ω)} {X : Ω' → ℝ≥0∞} (hX : Measurable X) :
    IsEVar X (mapNull φ S) ↔ IsEVar (X ∘ φ) S := by
  sorry

/-- The null generated by a family of bets (Layer 0.6). The σ-algebra is an instance argument. -/
def polarNull {Ω' : Type*} [MeasurableSpace Ω'] (𝓔 : Set (Ω' → ℝ≥0∞)) : Set (Measure Ω') :=
  {μ | ∀ X ∈ 𝓔, ∫⁻ ω, X ω ∂μ ≤ 1}

/-- The upper expectation of a null (Layer 0.6). -/
def upperExp (S : Set (Measure Ω)) (X : Ω → ℝ≥0∞) : ℝ≥0∞ :=
  ⨆ P ∈ S, ∫⁻ ω, X ω ∂P

/-- The Galois connection between nulls and sets of bets, for every null (Layer 0.6). -/
theorem subset_setOf_isEVar_iff {𝓔 : Set (Ω → ℝ≥0∞)} {S : Set (Measure Ω)}
    (h𝓔 : ∀ X ∈ 𝓔, Measurable X) :
    𝓔 ⊆ {X | IsEVar X S} ↔ S ⊆ polarNull 𝓔 :=
  ⟨fun h _ hμ _ hX ↦ (h hX).lintegral_le_one hμ, fun h X hX ↦ ⟨h𝓔 X hX, fun _ hμ ↦ h hμ X hX⟩⟩

/-- E-variables through the upper expectation, for every null (Layer 0.6). -/
theorem isEVar_iff_upperExp_le_one {S : Set (Measure Ω)} {X : Ω → ℝ≥0∞} :
    IsEVar X S ↔ Measurable X ∧ upperExp S X ≤ 1 := by
  sorry

/-- The effective null is the polar of the set of e-variables, by definition (Layer 1.1). -/
theorem effectiveSet_eq_polarNull (S : Set (Measure Ω)) :
    effectiveSet S = polarNull {X | IsEVar X S} :=
  rfl

/-- Every polar is convex (Layer 0.6). -/
theorem convex_polarNull (𝓔 : Set (Ω → ℝ≥0∞)) : Convex ℝ≥0∞ (polarNull 𝓔) := by
  sorry

/-- The quasi-sure filter of a null (Layer 0.6). -/
def quasiSure (S : Set (Measure Ω)) : Filter Ω :=
  ⨆ P ∈ S, ae P

theorem eventually_quasiSure_iff {S : Set (Measure Ω)} {p : Ω → Prop} :
    (∀ᶠ ω in quasiSure S, p ω) ↔ ∀ P ∈ S, ∀ᵐ ω ∂P, p ω := by
  simp only [quasiSure, eventually_iSup]

/-- A test of level `α` for `S` (Layer 0.1). -/
structure IsTest (φ : Ω → ℝ≥0∞) (S : Set (Measure Ω)) (α : ℝ≥0∞) : Prop where
  measurable : Measurable φ
  le_one : ∀ ω, φ ω ≤ 1
  lintegral_le : ∀ P ∈ S, ∫⁻ ω, φ ω ∂P ≤ α

/-- A test of level `α` is `α` times an e-variable [RW, Fact 3.6], for every null. -/
theorem isTest_iff_isEVar_div {S : Set (Measure Ω)} {φ : Ω → ℝ≥0∞} {α : ℝ≥0∞} (hα0 : α ≠ 0)
    (hα : α ≠ ∞) :
    IsTest φ S α ↔ (∀ ω, φ ω ≤ 1) ∧ IsEVar (fun ω ↦ φ ω / α) S := by
  sorry

/-- A p-variable for `S`, with values in `ℝ≥0∞` (Layer 0.1). -/
structure IsPVar (p : Ω → ℝ≥0∞) (S : Set (Measure Ω)) : Prop where
  measurable : Measurable p
  measure_le_le : ∀ P ∈ S, ∀ α : ℝ≥0∞, P {ω | p ω ≤ α} ≤ α

/-- Markov's inequality for e-variables, for every null [RW, Proposition 2.1]. -/
theorem IsEVar.measure_inv_le_le {E : Ω → ℝ≥0∞} {S : Set (Measure Ω)} (hE : IsEVar E S)
    {P : Measure Ω} (hP : P ∈ S) (α : ℝ≥0∞) :
    P {ω | α⁻¹ ≤ E ω} ≤ α := by
  sorry

/-- The e-to-p calibration `E ↦ E⁻¹`, for every null [RW, Proposition 2.1]. -/
theorem IsEVar.isPVar_inv {E : Ω → ℝ≥0∞} {S : Set (Measure Ω)} (hE : IsEVar E S) :
    IsPVar (fun ω ↦ (E ω)⁻¹) S := by
  sorry

/-- The super-uniform null: the laws of p-variables (Layer 0.1). -/
def superUniformNull : Set (Measure ℝ≥0∞) :=
  {μ | IsProbabilityMeasure μ ∧ ∀ α : ℝ≥0∞, μ (Iic α) ≤ α}

/-- P-variables are the measurable statistics whose laws are super-uniform (Layer 0.1). -/
theorem isPVar_iff_mapNull_subset {S : Set (Measure Ω)} (hS : ∀ P ∈ S, IsProbabilityMeasure P)
    {p : Ω → ℝ≥0∞} (hp : Measurable p) : IsPVar p S ↔ mapNull p S ⊆ superUniformNull := by
  sorry

/-- The e-variables for the super-uniform null are the measurable functions whose antitone
envelope has integral at most one on `[0, 1]` (Layer 0.2). -/
theorem isEVar_superUniformNull_iff {f : ℝ≥0∞ → ℝ≥0∞} (hf : Measurable f) :
    IsEVar f superUniformNull ↔
      ∫⁻ x in Icc (0 : ℝ) 1, ⨆ q ≥ ENNReal.ofReal x, f q ≤ 1 := by
  sorry

/-- A p-to-e calibrator, defined by the characterization of [RW, Proposition 2.5]. -/
def IsPToECalibrator (f : ℝ≥0∞ → ℝ≥0∞) : Prop :=
  Antitone f ∧ (∀ x, 1 < x → f x = 0) ∧ ∫⁻ x in Icc (0 : ℝ) 1, f (ENNReal.ofReal x) ≤ 1

/-- A calibrator turns every p-variable into an e-variable [VW21, Proposition 2.1]. -/
theorem IsPToECalibrator.isEVar_comp {f : ℝ≥0∞ → ℝ≥0∞} (hf : IsPToECalibrator f)
    {S : Set (Measure Ω)} (hS : ∀ P ∈ S, IsProbabilityMeasure P) {p : Ω → ℝ≥0∞}
    (hp : IsPVar p S) :
    IsEVar (f ∘ p) S := by
  sorry

/-- The randomized Markov inequality [RW, Theorem 2.9; RM26, Theorem 1.2]. -/
theorem measure_le_mul_eq_lintegral_min {P : Measure Ω} [IsProbabilityMeasure P]
    {Y : Ω → ℝ≥0∞} (hY : Measurable Y) {U : Ω → ℝ} (hU : Measurable U)
    (hU_law : P.map U = volume.restrict (Icc 0 1)) (hUY : IndepFun U Y P) (α : ℝ≥0∞) :
    P {ω | ENNReal.ofReal (U ω) ≤ α * Y ω} = ∫⁻ ω, min (α * Y ω) 1 ∂P := by
  sorry

/-- Post-hoc validity of a family of tests indexed by their levels [RW, Definition 4.1]. -/
def IsPostHocValid (φ : ℝ≥0∞ → Ω → ℝ≥0∞) (S : Set (Measure Ω)) : Prop :=
  ∀ P ∈ S, ∫⁻ ω, ⨆ α ∈ Ioo (0 : ℝ≥0∞) 1, φ α ω / α ∂P ≤ 1

/-- The tests `min (α * E) 1` of an e-variable are post-hoc valid, for every null
[RW, Proposition 4.3]. -/
theorem IsEVar.isPostHocValid {E : Ω → ℝ≥0∞} {S : Set (Measure Ω)} (hE : IsEVar E S) :
    IsPostHocValid (fun α ω ↦ min (α * E ω) 1) S := by
  sorry

/-! ## Layer 1: log-optimal e-variables and the structure of nulls -/

/-- The smallest relative entropy from `Q` to a null, with Statlib's `klIntegral` (Layer 1.1). -/
def klInf (Q : Measure Ω) (S : Set (Measure Ω)) : EReal :=
  ⨅ P ∈ S, klIntegral Q P

/-- The largest expected logarithm of an e-variable for `S` under `Q` (Layer 1.1). -/
def maxEPower (Q : Measure Ω) (S : Set (Measure Ω)) : EReal :=
  maxUtility Q S logUtility

/-- For probability measures, `klInf` is the infimum of Mathlib's `klDiv` (Layer 1.1). -/
theorem klInf_eq_iInf_klDiv (Q : Measure Ω) [IsProbabilityMeasure Q] {S : Set (Measure Ω)}
    (hS : ∀ P ∈ S, IsProbabilityMeasure P) :
    klInf Q S = ⨅ P ∈ S, (klDiv Q P : EReal) := by
  sorry

/-- Statlib's duality: the largest expected logarithm of an e-variable is the smallest relative
entropy to the effective null (Layer 1.1). -/
theorem maxEPower_eq_klInf_effectiveSet (Q : Measure Ω) [IsProbabilityMeasure Q]
    {S : Set (Measure Ω)} (hS : ∀ P ∈ S, P univ ≤ 1) :
    maxEPower Q S = klInf Q (effectiveSet S) :=
  maxUtility_eq_iInf_klIntegral_effectiveSet hS

/-- The largest expected logarithm of an e-variable is at most the smallest relative entropy to
the null, for a null of masses at most one (Layer 1.1). -/
theorem maxEPower_le_klInf (Q : Measure Ω) [IsProbabilityMeasure Q] {S : Set (Measure Ω)}
    (hS : ∀ P ∈ S, P univ ≤ 1) : maxEPower Q S ≤ klInf Q S := by
  sorry

/-- A powered test exists exactly outside the effective null, for every null
[RW, Theorem 6.10]. -/
theorem exists_powered_test_iff {S : Set (Measure Ω)} (Q : Measure Ω) [IsProbabilityMeasure Q] :
    (∃ α : ℝ≥0∞, 0 < α ∧ α < 1 ∧ ∃ φ : Ω → ℝ≥0∞, Measurable φ ∧ (∀ ω, φ ω ≤ 1) ∧
        (∀ P ∈ S, ∫⁻ ω, φ ω ∂P ≤ α) ∧ α < ∫⁻ ω, φ ω ∂Q) ↔
      Q ∉ effectiveSet S := by
  sorry

/-- The null generated by a set of constraints [LRR26, Definition 2.1]. -/
def constraintNull {𝓧 : Type*} [MeasurableSpace 𝓧] (Φ : Set (𝓧 → ℝ)) : Set (Measure 𝓧) :=
  {μ | IsProbabilityMeasure μ ∧ ∀ f ∈ Φ, Integrable f μ ∧ ∫ x, f x ∂μ ≤ 0}

/-- The bets on finitely many constraints [LRR26, Corollary 3.3]. -/
def constraintBets {𝓧 : Type*} [MeasurableSpace 𝓧] {ι : Type*} [Fintype ι] (g : ι → 𝓧 → ℝ) :
    Set (ι → ℝ≥0) :=
  {π | ∀ μ ∈ constraintNull (range g), ∀ᵐ x ∂μ, 0 ≤ 1 + ∑ i, (π i : ℝ) * g i x}

/-- For finitely many constraints, every e-variable is quasi-surely dominated by a bet on the
constraints [LRR26, Theorem 3.1]. -/
theorem IsEVar.exists_le_one_add_sum_constraintNull {𝓧 : Type*} [MeasurableSpace 𝓧]
    {ι : Type*} [Fintype ι] (f : ι → 𝓧 → ℝ) (hf : ∀ i, Measurable (f i)) {E : 𝓧 → ℝ≥0∞}
    (hE : IsEVar E (constraintNull (range f))) :
    ∃ π : ι → ℝ≥0, ∀ μ ∈ constraintNull (range f),
      ∀ᵐ x ∂μ, E x ≤ ENNReal.ofReal (1 + ∑ i, (π i : ℝ) * f i x) := by
  sorry

/-- For finitely many constraints, with no constraint qualification, every e-variable is
quasi-surely dominated by an admissible bet: a bet that every e-variable quasi-surely above it is
quasi-surely below (Layer 1.4). -/
theorem IsEVar.exists_admissible_bet_constraintNull {𝓧 : Type*} [MeasurableSpace 𝓧]
    {ι : Type*} [Fintype ι] (g : ι → 𝓧 → ℝ) (hg : ∀ i, Measurable (g i)) {E : 𝓧 → ℝ≥0∞}
    (hE : IsEVar E (constraintNull (range g))) :
    ∃ π ∈ constraintBets g,
      (∀ μ ∈ constraintNull (range g),
        ∀ᵐ x ∂μ, E x ≤ ENNReal.ofReal (1 + ∑ i, (π i : ℝ) * g i x)) ∧
      ∀ F : 𝓧 → ℝ≥0∞, IsEVar F (constraintNull (range g)) →
        (∀ μ ∈ constraintNull (range g),
          ∀ᵐ x ∂μ, ENNReal.ofReal (1 + ∑ i, (π i : ℝ) * g i x) ≤ F x) →
        ∀ μ ∈ constraintNull (range g),
          ∀ᵐ x ∂μ, F x ≤ ENNReal.ofReal (1 + ∑ i, (π i : ℝ) * g i x) := by
  sorry

/-- Lagrange duality for finitely many constraints under Slater's condition [Lue69, Chapter 8]. -/
theorem iInf_eq_iSup_iInf_add_of_slater {V : Type*} [AddCommGroup V] [Module ℝ V] {C : Set V}
    (hC : Convex ℝ C) {F : V → ℝ} (hF : ConvexOn ℝ C F) {ι : Type*} [Fintype ι] {h : ι → V → ℝ}
    (hh : ∀ i, ConvexOn ℝ C (h i)) (hslater : ∃ x₀ ∈ C, ∀ i, h i x₀ < 0)
    (hbdd : BddBelow (F '' {x ∈ C | ∀ i, h i x ≤ 0})) :
    ∃ π : ι → ℝ≥0, (⨅ x : {x ∈ C | ∀ i, h i x ≤ 0}, F x) =
      ⨅ x : C, (F x + ∑ i, (π i : ℝ) * h i x) := by
  sorry

/-- The dual formula for `KL_inf` of a finitely generated null, with no constraint qualification
(Layer 1.4): every `log⁺ |g i|` is integrable under `Q`. The right side is the supremum of the
expected logarithms of the bets. -/
theorem klInf_constraintNull_eq {𝓧 : Type*} [MeasurableSpace 𝓧] {ι : Type*} [Fintype ι]
    (g : ι → 𝓧 → ℝ) (hg : ∀ i, Measurable (g i)) (Q : Measure 𝓧) [IsProbabilityMeasure Q]
    (hQ : ∀ i, Integrable (fun x ↦ Real.posLog (g i x)) Q) :
    klInf Q (constraintNull (range g)) =
      ⨆ π ∈ constraintBets g,
        ∫ᵉ x, ENNReal.log (ENNReal.ofReal (1 + ∑ i, (π i : ℝ) * g i x)) ∂Q := by
  sorry

/-- The null of a finite-valued presentation by bets is the probability measures of their polar
(Layer 1.4). -/
theorem constraintNull_image_sub_one {𝓧 : Type*} [MeasurableSpace 𝓧] {𝓔₀ : Set (𝓧 → ℝ≥0∞)}
    (h𝓔₀ : ∀ Y ∈ 𝓔₀, Measurable Y) (h𝓔₀_top : ∀ Y ∈ 𝓔₀, ∀ x, Y x ≠ ∞) :
    constraintNull ((fun Y x ↦ (Y x).toReal - 1) '' 𝓔₀) =
      polarNull 𝓔₀ ∩ {μ | IsProbabilityMeasure μ} := by
  sorry

/-- The pointwise closure of a set of measures on a countable space (Layer 1.1): the measures whose
masses of points are in the closure, for the product topology, of those of the members. -/
def pointwiseClosure {𝓧 : Type*} [MeasurableSpace 𝓧] (S : Set (Measure 𝓧)) : Set (Measure 𝓧) :=
  {R | (fun x ↦ R {x}) ∈ closure ((fun P : Measure 𝓧 ↦ fun x ↦ P {x}) '' S)}

/-- On a countable alphabet, the effective null of `n` i.i.d. observations is the set of the
measures below a mixture of the products of the members of the pointwise closure (Layer 1.1)
[EVR26, Note 43, Theorem 2]. -/
theorem effectiveSet_sampleNull_eq_of_countable {𝓧 : Type*} [MeasurableSpace 𝓧] [Countable 𝓧]
    [MeasurableSingletonClass 𝓧] {S₁ : Set (Measure 𝓧)} (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P)
    (hS₁_ne : S₁.Nonempty) (n : ℕ) :
    effectiveSet (sampleNull S₁ n) = {μ | ∃ π : Measure (Measure 𝓧), IsProbabilityMeasure π ∧
      π (pointwiseClosure S₁)ᶜ = 0 ∧
      ∀ A, MeasurableSet A → μ A ≤ ∫⁻ R, (Measure.pi fun _ : Fin n ↦ R) A ∂π} := by
  sorry

/-- The countably additive part of a set function: the supremum of the measures below it on the
measurable sets (Layer 1.1, Conventions). -/
def countablyAdditivePart (ν : Set Ω → ℝ≥0∞) : Measure Ω :=
  sSup {μ : Measure Ω | ∀ s, MeasurableSet s → μ s ≤ ν s}

/-- The countably additive part of an additive content on the measurable sets is below it, so that
it is the largest measure below the content (Layer 1.1). -/
theorem countablyAdditivePart_apply_le (m : AddContent ℝ≥0∞ {s : Set Ω | MeasurableSet s})
    {s : Set Ω} (hs : MeasurableSet s) : (countablyAdditivePart ⇑m : Measure Ω) s ≤ m s := by
  sorry

/-- **The Yosida–Hewitt decomposition** [YH52] (Layer 1.1): the remainder of an additive content of
finite mass after its countably additive part is singular to every finite measure. -/
theorem exists_measurableSet_add_sub_countablyAdditivePart_lt
    (m : AddContent ℝ≥0∞ {s : Set Ω | MeasurableSet s}) (hm : m univ ≠ ∞) (R : Measure Ω)
    [IsFiniteMeasure R] {ε : ℝ≥0∞} (hε : 0 < ε) :
    ∃ E, MeasurableSet E ∧ R E + (m Eᶜ - (countablyAdditivePart ⇑m : Measure Ω) Eᶜ) < ε := by
  sorry

/-- The Yosida–Hewitt decomposition is unique [YH52] (Layer 1.1): if an additive content of finite
mass is, on the measurable sets, the sum of a measure `μ` and of a set function below which the
only measure is `0`, then `μ` is its countably additive part. -/
theorem countablyAdditivePart_eq_of_eq_add (m : AddContent ℝ≥0∞ {s : Set Ω | MeasurableSet s})
    (hm : m univ ≠ ∞) (μ : Measure Ω) (p : Set Ω → ℝ≥0∞)
    (hp : ∀ μ' : Measure Ω, (∀ s, MeasurableSet s → μ' s ≤ p s) → μ' = 0)
    (hmp : ∀ s, MeasurableSet s → m s = μ s + p s) :
    countablyAdditivePart ⇑m = μ := by
  sorry

/-- The measure on the cells of a finite partition `f : Ω → Fin k` with the masses of a set
function `ν` (Layer 1.1). -/
def cellMeasure (ν : Set Ω → ℝ≥0∞) {k : ℕ} (f : Ω → Fin k) : Measure (Fin k) :=
  Measure.sum fun j ↦ ν (f ⁻¹' {j}) • Measure.dirac j

/-- The divergence `H(R | ν)` from a measure to a set function: the supremum, over the finite
measurable partitions, of the divergence from the image of `R` to the cell masses of `ν`
(Layer 1.1). -/
def partitionDivergence (R : Measure Ω) (ν : Set Ω → ℝ≥0∞) : EReal :=
  ⨆ (k : ℕ) (f : Ω → Fin k) (_ : Measurable f), klIntegral (R.map f) (cellMeasure ν f)

/-- The divergence to an additive content of mass at most one is the divergence to its countably
additive part (Layer 1.1). The generalized null laws of Layer 6.1 use the inequality `≥`. -/
theorem partitionDivergence_eq_klIntegral_countablyAdditivePart (R : Measure Ω)
    [IsProbabilityMeasure R] (m : AddContent ℝ≥0∞ {s : Set Ω | MeasurableSet s})
    (hm : m univ ≤ 1) :
    partitionDivergence R ⇑m = klIntegral R (countablyAdditivePart ⇑m) := by
  sorry

/-! ## Layer 2: test supermartingales, optional stopping and Ville's inequality -/

/-- A conditional e-variable given `m` for `S`, in set-integral form (Layer 2.1). -/
structure IsCondEVar (X : Ω → ℝ≥0∞) (m : MeasurableSpace Ω) (S : Set (@Measure Ω mΩ)) :
    Prop where
  measurable : Measurable[mΩ] X
  setLIntegral_le : ∀ P ∈ S, ∀ s, MeasurableSet[m] s → ∫⁻ ω in s, X ω ∂P ≤ P s

/-- The conditioning hull of a null given a σ-algebra: the conditional laws of its members given
the events of the σ-algebra that they charge (Layer 2.1). -/
def condNull (m : MeasurableSpace Ω) (S : Set (Measure Ω)) : Set (Measure Ω) :=
  {μ | ∃ P ∈ S, ∃ s, MeasurableSet[m] s ∧ P s ≠ 0 ∧ μ = P[|s]}

/-- A conditional e-variable is an e-variable for the conditioning hull, for every null
(Layer 2.1). -/
theorem isCondEVar_iff_isEVar_condNull {m : MeasurableSpace Ω} {S : Set (Measure Ω)}
    {X : Ω → ℝ≥0∞} :
    IsCondEVar X m S ↔ IsEVar X (condNull m S) := by
  sorry

/-- An `ℝ≥0∞`-valued supermartingale for every member of `S`, in set-integral form
(Layer 2.1). -/
structure IsENNSupermartingale (M : ℕ → Ω → ℝ≥0∞) (ℱ : Filtration ℕ mΩ)
    (S : Set (Measure Ω)) : Prop where
  adapted : ∀ n, Measurable[ℱ n] (M n)
  setLIntegral_succ_le : ∀ P ∈ S, ∀ n s, MeasurableSet[ℱ n] s →
    ∫⁻ ω in s, M (n + 1) ω ∂P ≤ ∫⁻ ω in s, M n ω ∂P

/-- A test supermartingale for every member of `S`, with values in `ℝ≥0∞` [RW, Definition 7.3]. -/
structure IsTestSupermartingale (M : ℕ → Ω → ℝ≥0∞) (ℱ : Filtration ℕ mΩ)
    (S : Set (Measure Ω)) : Prop extends IsENNSupermartingale M ℱ S where
  lintegral_zero_le : ∀ P ∈ S, ∫⁻ ω, M 0 ω ∂P ≤ 1

/-- A test martingale for every member of `S` [RW, Definition 7.3]. -/
structure IsTestMartingale (M : ℕ → Ω → ℝ≥0∞) (ℱ : Filtration ℕ mΩ)
    (S : Set (Measure Ω)) : Prop where
  adapted : ∀ n, Measurable[ℱ n] (M n)
  lintegral_zero_le : ∀ P ∈ S, ∫⁻ ω, M 0 ω ∂P ≤ 1
  setLIntegral_succ_eq : ∀ P ∈ S, ∀ n s, MeasurableSet[ℱ n] s →
    ∫⁻ ω in s, M (n + 1) ω ∂P = ∫⁻ ω in s, M n ω ∂P

/-- The value of a process at a possibly infinite time, `limsup` at infinity
[RRLK; RLKR23, (1.2)]. -/
def stoppedValueLimsup (E : ℕ → Ω → ℝ≥0∞) (τ : Ω → WithTop ℕ) (ω : Ω) : ℝ≥0∞ :=
  if h : τ ω = ⊤ then limsup (fun n ↦ E n ω) atTop else E ((τ ω).untop h) ω

variable {ℱ : Filtration ℕ mΩ} {S : Set (Measure Ω)}

/-- Products of sequential e-variables are test supermartingales [RW, Proposition 7.20]. -/
theorem isTestSupermartingale_prod (hS : ∀ P ∈ S, IsProbabilityMeasure P)
    {E : ℕ → Ω → ℝ≥0∞} (hE_meas : ∀ k, Measurable[ℱ (k + 1)] (E k))
    (hE : ∀ k, IsCondEVar (E k) (ℱ k) S) :
    IsTestSupermartingale (fun n ω ↦ ∏ k ∈ Finset.range n, E k ω) ℱ S := by
  sorry

/-- Portfolio wealth processes are test supermartingales [WSJ26; RW, Definition 7.21]. The
portfolios are the points of `LMLExplore.simplex ι`, through `ENNReal.ofReal`. -/
theorem isTestSupermartingale_portfolio (hS : ∀ P ∈ S, IsProbabilityMeasure P)
    {ι : Type*} [Fintype ι] {E : ℕ → ι → Ω → ℝ≥0∞}
    (hE_meas : ∀ k i, Measurable[ℱ (k + 1)] (E k i)) (hE : ∀ k i, IsCondEVar (E k i) (ℱ k) S)
    {w : ℕ → Ω → ι → ℝ≥0∞} (hw : ∀ k i, Measurable[ℱ k] (fun ω ↦ w k ω i))
    (hw_sum : ∀ k ω, ∑ i, w k ω i = 1) :
    IsTestSupermartingale (fun n ω ↦ ∏ k ∈ Finset.range n, ∑ i, w k ω i * E k i ω) ℱ S := by
  sorry

/-- Optional stopping at arbitrary stopping times, with the value `limsup` at infinity
[RW, Fact 7.5]. -/
theorem IsTestSupermartingale.lintegral_stoppedValueLimsup_le {M : ℕ → Ω → ℝ≥0∞}
    {P : Measure Ω} [IsProbabilityMeasure P] (hM : IsTestSupermartingale M ℱ {P})
    {τ : Ω → WithTop ℕ} (hτ : IsStoppingTime ℱ τ) :
    ∫⁻ ω, stoppedValueLimsup M τ ω ∂P ≤ ∫⁻ ω, M 0 ω ∂P := by
  sorry

/-- Ville's inequality for test supermartingales in `ℝ≥0∞` [Vil39; RW, Fact 7.6]. -/
theorem IsTestSupermartingale.measure_exists_le_le {M : ℕ → Ω → ℝ≥0∞} {P : Measure Ω}
    [IsProbabilityMeasure P] (hM : IsTestSupermartingale M ℱ {P}) {c : ℝ≥0∞} (hc : c ≠ 0) :
    P {ω | ∃ n, c ≤ M n ω} ≤ (∫⁻ ω, M 0 ω ∂P) / c := by
  sorry

/-! ## Layer 3: e-processes -/

/-- An e-process for `S`: its value at every stopping time with values in `ℕ` is an e-variable
[RW, Definition 7.3(ii)]. -/
structure IsEProcess (E : ℕ → Ω → ℝ≥0∞) (ℱ : Filtration ℕ mΩ) (S : Set (Measure Ω)) :
    Prop where
  adapted : ∀ n, Measurable[ℱ n] (E n)
  isEVar_stoppedValue : ∀ τ : Ω → ℕ, IsStoppingTime ℱ (fun ω ↦ (τ ω : WithTop ℕ)) →
    IsEVar (fun ω ↦ E (τ ω) ω) S

/-- The optional σ-algebra of a filtration on `ℕ × Ω`: the sets whose section at each time `n` is
`ℱ n`-measurable (Layer 3.1). -/
@[reducible]
def optionalSigma (ℱ : Filtration ℕ mΩ) : MeasurableSpace (ℕ × Ω) where
  MeasurableSet' B := ∀ n, MeasurableSet[ℱ n] {ω | (n, ω) ∈ B}
  measurableSet_empty := by simp
  measurableSet_compl B hB n := by
    change MeasurableSet[ℱ n] {ω | (n, ω) ∈ B}ᶜ
    exact (hB n).compl
  measurableSet_iUnion B hB n := by
    have : {ω | (n, ω) ∈ ⋃ i, B i} = ⋃ i, {ω | (n, ω) ∈ B i} := by ext; simp
    rw [this]
    exact MeasurableSet.iUnion fun i ↦ hB i n

/-- The law of the time and the state at a random time `τ` (Layer 3.1). -/
def stoppedLaw (ℱ : Filtration ℕ mΩ) (P : Measure Ω) (τ : Ω → ℕ) :
    @Measure (ℕ × Ω) (optionalSigma ℱ) :=
  @Measure.map Ω (ℕ × Ω) mΩ (optionalSigma ℱ) (fun ω ↦ (τ ω, ω)) P

/-- The null of the stopped laws of the members of `S` at the stopping times with values in `ℕ`
(Layer 3.1). -/
def stoppedNull (ℱ : Filtration ℕ mΩ) (S : Set (Measure Ω)) :
    Set (@Measure (ℕ × Ω) (optionalSigma ℱ)) :=
  {μ | ∃ P ∈ S, ∃ τ : Ω → ℕ, IsStoppingTime ℱ (fun ω ↦ (τ ω : WithTop ℕ)) ∧
    μ = stoppedLaw ℱ P τ}

/-- An e-process is an e-variable on the space of stopped paths, for every null [KG22, Section 3]
(Layer 3.1). -/
theorem isEProcess_iff_isEVar_stoppedNull {E : ℕ → Ω → ℝ≥0∞} :
    IsEProcess E ℱ S ↔
      @IsEVar (ℕ × Ω) (optionalSigma ℱ) (Function.uncurry E) (stoppedNull ℱ S) := by
  sorry

/-- **An optimal e-process for a distribution over times** (Layer 3.8). For a null of
probability measures, a probability measure `Q` and weights `ρ` on the times, some e-process `E*`
satisfies `∑' n, ρ n * ∫⁻ E n / E* n ∂Q ≤ 1` for every e-process `E`. No dominating measure is
assumed. -/
theorem exists_isEProcess_forall_tsum_lintegral_div_le (hS : ∀ P ∈ S, IsProbabilityMeasure P)
    (Q : Measure Ω) [IsProbabilityMeasure Q] (ρ : ℕ → ℝ≥0∞) (hρ : ∑' n, ρ n = 1) :
    ∃ E : ℕ → Ω → ℝ≥0∞, IsEProcess E ℱ S ∧ ∀ F : ℕ → Ω → ℝ≥0∞, IsEProcess F ℱ S →
      ∑' n, ρ n * ∫⁻ ω, F n ω / E n ω ∂Q ≤ 1 := by
  sorry

/-- A sequential test of level `α`, as a stopping time (Layer 3.3). -/
structure IsLevelStoppingTime (τ : Ω → WithTop ℕ) (ℱ : Filtration ℕ mΩ) (S : Set (Measure Ω))
    (α : ℝ≥0∞) : Prop where
  isStoppingTime : IsStoppingTime ℱ τ
  measure_lt_top_le : ∀ P ∈ S, P {ω | τ ω < ⊤} ≤ α

/-- Ville's inequality for e-processes [RW, Fact 7.6]. -/
theorem IsEProcess.measure_exists_inv_le_le {E : ℕ → Ω → ℝ≥0∞} (hE : IsEProcess E ℱ S)
    {P : Measure Ω} (hP : P ∈ S) [IsProbabilityMeasure P] (α : ℝ≥0∞) :
    P {ω | ∃ n, α⁻¹ ≤ E n ω} ≤ α := by
  sorry

/-- The essential supremum of a family of functions, attained along a countable subfamily
[RRLK, Appendix A; FS16, §A.5]. -/
theorem exists_essSup_family {μ : Measure Ω} [SigmaFinite μ] (𝒳 : Set (Ω → ℝ≥0∞))
    (h𝒳 : 𝒳.Nonempty) (h𝒳_meas : ∀ X ∈ 𝒳, Measurable X) :
    ∃ Z : Ω → ℝ≥0∞, Measurable Z ∧ (∀ X ∈ 𝒳, X ≤ᵐ[μ] Z) ∧
      (∀ Y, Measurable Y → (∀ X ∈ 𝒳, X ≤ᵐ[μ] Y) → Z ≤ᵐ[μ] Y) ∧
      ∃ s : ℕ → Ω → ℝ≥0∞, (∀ n, s n ∈ 𝒳) ∧ Z =ᵐ[μ] fun ω ↦ ⨆ n, s n ω := by
  sorry

/-- The characterization of e-processes by test martingale families [RRLK, Lemma 6]. -/
theorem isEProcess_iff_forall_exists_isTestMartingale (hS : ∀ P ∈ S, IsProbabilityMeasure P)
    {E : ℕ → Ω → ℝ≥0∞} (hE : ∀ n, Measurable[ℱ n] (E n)) :
    IsEProcess E ℱ S ↔
      ∀ P ∈ S, ∃ M, IsTestMartingale M ℱ {P} ∧ ∀ᵐ ω ∂P, ∀ n, E n ω ≤ M n ω := by
  sorry

/-- Validity at every stopping time, with the value `limsup` at infinity [RRLK, Lemma 6]. -/
theorem IsEProcess.isEVar_stoppedValueLimsup (hS : ∀ P ∈ S, IsProbabilityMeasure P)
    {E : ℕ → Ω → ℝ≥0∞} (hE : IsEProcess E ℱ S) {τ : Ω → WithTop ℕ} (hτ : IsStoppingTime ℱ τ) :
    IsEVar (stoppedValueLimsup E τ) S := by
  sorry

/-- An adjuster, monotone on `[1, ∞]` [CR26; ShSVV11, Theorem 4]. -/
def IsAdjuster (A : ℝ≥0∞ → ℝ≥0∞) : Prop :=
  MonotoneOn A (Ici 1) ∧ ∫⁻ x in Ioi (1 : ℝ), A (ENNReal.ofReal x) / ENNReal.ofReal (x ^ 2) ≤ 1

/-- Adjusting the running maximum lifts an e-process to a finer filtration [CR26, Theorem 2]. -/
theorem IsEProcess.adjust {G : Filtration ℕ mΩ} (hGℱ : G ≤ ℱ)
    (hS : ∀ P ∈ S, IsProbabilityMeasure P) {E : ℕ → Ω → ℝ≥0∞} (hE : IsEProcess E G S)
    {A : ℝ≥0∞ → ℝ≥0∞} (hA : IsAdjuster A) (hA_meas : Measurable A) :
    IsEProcess (fun n ω ↦ A (max 1 (⨆ k ∈ Finset.range (n + 1), E k ω))) ℱ S := by
  sorry

/-- The inverse capital outer measure of [RLKR23, (2.1)]. -/
def inverseCapital (ℱ : Filtration ℕ mΩ) (S : Set (Measure Ω)) (A : Set Ω) : ℝ≥0∞ :=
  ⨅ (τ : Ω → WithTop ℕ) (_ : IsStoppingTime ℱ τ) (_ : A ⊆ {ω | τ ω < ⊤}),
    ⨆ P ∈ S, P {ω | τ ω < ⊤}

/-- The composite Ville theorem [RLKR23, Theorem 3.1]. -/
theorem inverseCapital_eq_zero_iff (hℱ : mΩ = ⨆ n, ℱ n) (hS : ∀ P ∈ S, IsProbabilityMeasure P)
    (A : Set Ω) :
    inverseCapital ℱ S A = 0 ↔
      ∃ E, IsEProcess E ℱ S ∧ ∀ ω ∈ A, Tendsto (fun n ↦ E n ω) atTop (𝓝 ⊤) := by
  sorry

/-! ## Layer 4: constructions of e-processes -/

/-- Likelihood ratios of a sequential predictor, given by its density `r k ω` with respect to the
conditional law `κ k ω` of the observation `X k` given `ℱ k`, are test supermartingales
(Layer 4.2). -/
theorem isTestSupermartingale_prod_density {𝓧 : Type*} [m𝓧 : MeasurableSpace 𝓧]
    {P : Measure Ω} [IsProbabilityMeasure P] {X : ℕ → Ω → 𝓧}
    (hX : ∀ k, Measurable[ℱ (k + 1)] (X k)) {κ : ℕ → Ω → Measure 𝓧}
    (hκ : ∀ k (g : Ω → 𝓧 → ℝ≥0∞),
      Measurable[(ℱ k : MeasurableSpace Ω).prod m𝓧] (Function.uncurry g) →
      ∀ s, MeasurableSet[ℱ k] s →
        ∫⁻ ω in s, g ω (X k ω) ∂P = ∫⁻ ω in s, ∫⁻ x, g ω x ∂(κ k ω) ∂P)
    {r : ℕ → Ω → 𝓧 → ℝ≥0∞}
    (hr : ∀ k, Measurable[(ℱ k : MeasurableSpace Ω).prod m𝓧] (Function.uncurry (r k)))
    (hr_le : ∀ k ω, ∫⁻ x, r k ω x ∂(κ k ω) ≤ 1) :
    IsTestSupermartingale (fun n ω ↦ ∏ k ∈ Finset.range n, r k ω (X k ω)) ℱ {P} := by
  sorry

/-- The sequential null of finitely many conditional constraints (Layer 4.4). -/
def seqConstraintNull {𝓧 : Type*} [MeasurableSpace 𝓧] {ι : Type*} [Fintype ι]
    (g : ι → 𝓧 → ℝ) (X : ℕ → Ω → 𝓧) (ℱ : Filtration ℕ mΩ) : Set (Measure Ω) :=
  {P | IsProbabilityMeasure P ∧ ∀ i k, Integrable (fun ω ↦ g i (X k ω)) P ∧
    ∀ s, MeasurableSet[ℱ k] s → ∫ ω in s, g i (X k ω) ∂P ≤ 0}

/-- Betting against conditional constraints is a test supermartingale (Layer 4.4); the betting
martingale of OnlineLearning 16.4 is the case of one mean constraint on `[0, 1]`. -/
theorem isTestSupermartingale_betting {𝓧 : Type*} [MeasurableSpace 𝓧] {ι : Type*} [Fintype ι]
    {g : ι → 𝓧 → ℝ} (hg : ∀ i, Measurable (g i)) {X : ℕ → Ω → 𝓧}
    (hX : ∀ k, Measurable[ℱ (k + 1)] (X k)) {π : ℕ → Ω → ι → ℝ≥0}
    (hπ : ∀ k i, Measurable[ℱ k] (fun ω ↦ π k ω i))
    (hπ_nonneg : ∀ k ω x, 0 ≤ 1 + ∑ i, (π k ω i : ℝ) * g i x) :
    IsTestSupermartingale
      (fun n ω ↦ ∏ k ∈ Finset.range n, ENNReal.ofReal (1 + ∑ i, (π k ω i : ℝ) * g i (X k ω)))
      ℱ (seqConstraintNull g X ℱ) := by
  sorry

/-- The complete class against conditional constraints [Cle26b, Theorem 1], for inequality
constraints: every e-process is dominated by a betting wealth (Layer 4.4). The observations are the
coordinates of `ℕ → 𝓧`, and `ℱ n` is generated by the first `n` of them. -/
theorem IsEProcess.exists_betting_dominates {𝓧 : Type*} [MeasurableSpace 𝓧]
    [StandardBorelSpace 𝓧] {ι : Type*} [Fintype ι] {g : ι → 𝓧 → ℝ} (hg : ∀ i, Measurable (g i))
    {ℱ : Filtration ℕ (MeasurableSpace.pi : MeasurableSpace (ℕ → 𝓧))}
    (hℱ : ∀ n, (ℱ n : MeasurableSpace (ℕ → 𝓧)) =
      MeasurableSpace.comap (fun ω (i : Fin n) ↦ ω i) MeasurableSpace.pi)
    {E : ℕ → (ℕ → 𝓧) → ℝ≥0∞} (hE : IsEProcess E ℱ (seqConstraintNull g (fun k ω ↦ ω k) ℱ)) :
    ∃ π : ℕ → (ℕ → 𝓧) → ι → ℝ≥0, (∀ k i, Measurable[ℱ k] (fun ω ↦ π k ω i)) ∧
      ∀ P ∈ seqConstraintNull g (fun k ω ↦ ω k) ℱ, ∀ᵐ ω ∂P, ∀ n,
        E n ω ≤ ∏ k ∈ Finset.range n, ENNReal.ofReal (1 + ∑ i, (π k ω i : ℝ) * g i (ω k)) := by
  sorry

/-- The sequential null of one-step nulls that may depend on the round and on the past
(Layer 4.5): the probability measures under which, for every `k`, the observation `X k` has
Mathlib's conditional distribution `κ` given the identity of `Ω` into `(Ω, ℱ k)`, a kernel from
`(Ω, ℱ k)`, with `κ ω ∈ S₁ k ω` almost surely. -/
def sequentialNull {𝓧 : Type*} [m𝓧 : MeasurableSpace 𝓧] (S₁ : ℕ → Ω → Set (Measure 𝓧))
    (X : ℕ → Ω → 𝓧) (ℱ : Filtration ℕ mΩ) : Set (Measure Ω) :=
  {P | IsProbabilityMeasure P ∧ ∀ k, ∃ κ : @Kernel Ω 𝓧 (ℱ k) m𝓧,
    @HasCondDistrib Ω Ω 𝓧 mΩ (ℱ k) m𝓧 (X k) id κ P ∧ ∀ᵐ ω ∂P, κ ω ∈ S₁ k ω}

/-- The conditional distribution given a σ-algebra, in the set-integral form of LMLExplore's
`HasCondLaw` (Layer 4.5). -/
theorem hasCondDistrib_id_iff {𝓧 : Type*} [m𝓧 : MeasurableSpace 𝓧] {m : MeasurableSpace Ω}
    (hm : m ≤ mΩ) {Y : Ω → 𝓧} (hY : Measurable[mΩ] Y) {P : @Measure Ω mΩ}
    [@IsFiniteMeasure Ω mΩ P]
    (κ : @Kernel Ω 𝓧 m m𝓧) [@IsFiniteKernel Ω 𝓧 m m𝓧 κ] :
    @HasCondDistrib Ω Ω 𝓧 mΩ m m𝓧 Y id κ P ↔
      ∀ g : Ω → 𝓧 → ℝ≥0∞, Measurable[m.prod m𝓧] (Function.uncurry g) →
        ∫⁻ ω, g ω (Y ω) ∂P = ∫⁻ ω, ∫⁻ x, g ω x ∂(κ ω) ∂P := by
  sorry

/-- The dual form of the sequential null: the probability measures under which every bet of `𝓔`,
applied to each observation, is a conditional e-variable given the past (Layer 4.5). -/
def condEVarNull {𝓧 : Type*} [MeasurableSpace 𝓧] (𝓔 : Set (𝓧 → ℝ≥0∞)) (X : ℕ → Ω → 𝓧)
    (ℱ : Filtration ℕ mΩ) : Set (Measure Ω) :=
  {P | IsProbabilityMeasure P ∧ ∀ k, ∀ e ∈ 𝓔, IsCondEVar (fun ω ↦ e (X k ω)) (ℱ k) {P}}

/-- The sequential null of a constant one-step null is in the dual null of its bets
(Layer 4.5). -/
theorem sequentialNull_subset_condEVarNull {𝓧 : Type*} [MeasurableSpace 𝓧]
    {S₁ : Set (Measure 𝓧)} {𝓔 : Set (𝓧 → ℝ≥0∞)} (h𝓔 : ∀ e ∈ 𝓔, IsEVar e S₁) (X : ℕ → Ω → 𝓧)
    (hX : ∀ k, Measurable (X k)) :
    sequentialNull (fun _ _ ↦ S₁) X ℱ ⊆ condEVarNull 𝓔 X ℱ := by
  sorry

/-! ## Layer 5: confidence sequences -/

/-- A confidence sequence at level `α` for the parameters of the nulls `S` (Layer 5.1). -/
def IsConfSeq {Θ : Type*} (C : ℕ → Ω → Set Θ) (ℱ : Filtration ℕ mΩ) (S : Θ → Set (Measure Ω))
    (α : ℝ≥0∞) : Prop :=
  (∀ θ n, MeasurableSet[ℱ n] {ω | θ ∈ C n ω}) ∧
    ∀ θ, ∀ P ∈ S θ, P {ω | ∃ n, θ ∉ C n ω} ≤ α

/-- Families of e-processes give confidence sequences (Layer 5.2). -/
theorem isConfSeq_of_isEProcess {Θ : Type*} {S : Θ → Set (Measure Ω)}
    (hS : ∀ θ, ∀ P ∈ S θ, IsProbabilityMeasure P) {E : Θ → ℕ → Ω → ℝ≥0∞}
    (hE : ∀ θ, IsEProcess (E θ) ℱ (S θ)) (α : ℝ≥0∞) :
    IsConfSeq (fun n ω ↦ {θ | E θ n ω < α⁻¹}) ℱ S α := by
  sorry

/-! ## Layer 6: growth rates, power, expected stopping times and designs -/

/-- The filtration of the strict past on `ℕ → 𝓧` (Layer 6.1): at time `n`, the first `n`
coordinates, so that time `n` has seen `n` observations. -/
def piLT {𝓧 : Type*} [MeasurableSpace 𝓧] :
    Filtration ℕ (MeasurableSpace.pi : MeasurableSpace (ℕ → 𝓧)) where
  seq n := ⨆ i < n, MeasurableSpace.comap (fun ω : ℕ → 𝓧 ↦ ω i) inferInstance
  mono' _ _ h := iSup₂_mono' fun i hi ↦ ⟨i, hi.trans_le h, le_rfl⟩
  le' _ := iSup₂_le fun i _ ↦ (measurable_pi_apply i).comap_le

theorem piLT_succ {𝓧 : Type*} [MeasurableSpace 𝓧] (n : ℕ) :
    (piLT (𝓧 := 𝓧) : Filtration ℕ _) (n + 1) = Filtration.piLE (X := fun _ : ℕ ↦ 𝓧) n := by
  sorry

/-- The maximal expected logarithm of an `n`-sample e-variable for the i.i.d. laws of `S₁`, under
the `n`-fold product of `Q₁` (Layer 6.1). -/
def maxLogGrowth {𝓧 : Type*} [MeasurableSpace 𝓧] (Q₁ : Measure 𝓧) (S₁ : Set (Measure 𝓧))
    (n : ℕ) : EReal :=
  maxEPower (Measure.pi fun _ : Fin n ↦ Q₁) (sampleNull S₁ n)

/-- The optimal growth rate is superadditive, hence `maxLogGrowth Q₁ S₁ n / n` converges to its
supremum [RR26, Lemma 3.2, Theorem 3.5]. -/
theorem maxLogGrowth_add_le {𝓧 : Type*} [MeasurableSpace 𝓧] (Q₁ : Measure 𝓧)
    [IsProbabilityMeasure Q₁] (S₁ : Set (Measure 𝓧)) (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P)
    (m n : ℕ) :
    maxLogGrowth Q₁ S₁ m + maxLogGrowth Q₁ S₁ n ≤ maxLogGrowth Q₁ S₁ (m + n) := by
  sorry

/-- The optimal growth rate `d` of Layer 6.1: the supremum over `n ≥ 1`, equal to the limit, of
`maxLogGrowth Q₁ S₁ n / n`. In LMLExplore it is `ProbabilityTheory.bipolarRate`. -/
def bipolarRate {𝓧 : Type*} [MeasurableSpace 𝓧] (Q₁ : Measure 𝓧) (S₁ : Set (Measure 𝓧)) :
    EReal :=
  ⨆ n : ℕ, maxLogGrowth Q₁ S₁ (n + 1) / ((n + 1 : ℕ) : EReal)

/-- Almost surely under the i.i.d. law of `Q₁`, no sequence of `n`-sample e-variables for the
i.i.d. laws of `S₁` grows faster than the optimal growth rate (Layer 6.1). -/
theorem ae_limsup_log_div_le_bipolarRate {𝓧 : Type*} [MeasurableSpace 𝓧] (Q₁ : Measure 𝓧)
    (S₁ : Set (Measure 𝓧)) (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P)
    {M : (n : ℕ) → (Fin n → 𝓧) → ℝ≥0∞}
    (hM : ∀ n, IsEVar (M n) (sampleNull S₁ n)) :
    ∀ᵐ ω ∂Measure.infinitePi (fun _ : ℕ ↦ Q₁),
      limsup (fun n : ℕ ↦ ENNReal.log (M n fun i ↦ ω i) / (n : EReal)) atTop ≤
        bipolarRate Q₁ S₁ := by
  sorry

/-- The expected number of observations of a level-`α` sequential test for a null containing the
i.i.d. laws of `S₁` is at least `log (1 / α)` over the optimal growth rate (Layer 6.3). It is
infinite when the rate is `0`. With `piLT`, `τ` observations have been made at time `τ`. -/
theorem ofReal_log_inv_div_bipolarRate_le_lintegral {𝓧 : Type*} [MeasurableSpace 𝓧]
    (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁] (S₁ : Set (Measure 𝓧))
    (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P) {τ : (ℕ → 𝓧) → WithTop ℕ} {α : ℝ}
    (hτ : IsLevelStoppingTime τ piLT (iidNull S₁) (ENNReal.ofReal α)) :
    ENNReal.ofReal (Real.log α⁻¹) / (bipolarRate Q₁ S₁).toENNReal ≤
      ∫⁻ ω, ENat.toENNReal (τ ω) ∂Measure.infinitePi (fun _ : ℕ ↦ Q₁) := by
  sorry

/-- The expected stopping time of a level-`α` sequential test for a null containing the i.i.d.
laws of `S₁` [ARR26, Theorem 3.1], a corollary of the bound with the optimal growth rate. -/
theorem log_inv_le_lintegral_mul_klInf {𝓧 : Type*} [MeasurableSpace 𝓧]
    (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁] (S₁ : Set (Measure 𝓧))
    (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P) {τ : (ℕ → 𝓧) → WithTop ℕ} {α : ℝ} (hα0 : 0 < α)
    (hα1 : α < 1) (hτ : IsLevelStoppingTime τ piLT (iidNull S₁) (ENNReal.ofReal α))
    (hstop : ∀ᵐ ω ∂Measure.infinitePi (fun _ : ℕ ↦ Q₁), τ ω < ⊤) :
    ((Real.log α⁻¹ : ℝ) : EReal) ≤
      ((∫⁻ ω, ENat.toENNReal (τ ω) ∂Measure.infinitePi (fun _ : ℕ ↦ Q₁) : ℝ≥0∞) : EReal) *
        klInf Q₁ S₁ := by
  sorry

/-- The i.i.d. saturation of a null (Layer 6.1): the finite measures whose `n`-fold products lie
in the effective null of the `n`-sample null, for every `n ≥ 1`. -/
def iidSaturation {𝓧 : Type*} [MeasurableSpace 𝓧] (S₁ : Set (Measure 𝓧)) : Set (Measure 𝓧) :=
  {R | IsFiniteMeasure R ∧
    ∀ n ≠ 0, (Measure.pi fun _ : Fin n ↦ R) ∈ effectiveSet (sampleNull S₁ n)}

/-- The optimal growth rate is zero exactly on the i.i.d. saturation (Layer 6.1) [EVR26, Note 43,
Proposition 1]. -/
theorem bipolarRate_eq_zero_iff_mem_iidSaturation {𝓧 : Type*} [MeasurableSpace 𝓧]
    (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁] {S₁ : Set (Measure 𝓧)}
    (hS₁ : ∀ P ∈ S₁, P univ ≤ 1) :
    bipolarRate Q₁ S₁ = 0 ↔ Q₁ ∈ iidSaturation S₁ := by
  sorry

/-- The laws of the blocks of `k + 1` observations of `P`, as set functions (Layer 6.1). -/
def blockSetFunction {𝓧 : Type*} [MeasurableSpace 𝓧] (P : Measure 𝓧) :
    (k : ℕ) → Set (Fin (k + 1) → 𝓧) → ℝ≥0∞ :=
  fun k A ↦ Measure.pi (fun _ : Fin (k + 1) ↦ P) A

/-- The generalized null laws of `S₁`: the closure of the laws of the blocks of its members, for the
convergence on every set of every block (Layer 6.1, Conventions) [EVR26, Note 43]. -/
def generalizedNullLaws {𝓧 : Type*} [MeasurableSpace 𝓧] (S₁ : Set (Measure 𝓧)) :
    Set ((k : ℕ) → Set (Fin (k + 1) → 𝓧) → ℝ≥0∞) :=
  closure (blockSetFunction '' S₁)

/-- The optimal growth rate is the smallest divergence rate from the alternative to a generalized
null law, and the smallest value is attained (Layer 6.1) [EVR26, Note 43, Theorem 4]. -/
theorem isLeast_iSup_partitionDivergence_generalizedNullLaws {𝓧 : Type*} [MeasurableSpace 𝓧]
    (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁] {S₁ : Set (Measure 𝓧)}
    (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P) (hS₁_ne : S₁.Nonempty) :
    IsLeast ((fun ν ↦ ⨆ k : ℕ, partitionDivergence (Measure.pi fun _ : Fin (k + 1) ↦ Q₁) (ν k) /
      ((k + 1 : ℕ) : EReal)) '' generalizedNullLaws S₁) (bipolarRate Q₁ S₁) := by
  sorry

/-- When the countably additive parts of the generalized null laws are powers, the optimal growth
rate is the smallest divergence to the i.i.d. saturation (Layer 6.1) [EVR26, Note 43,
Corollary 5]. -/
theorem bipolarRate_eq_klInf_iidSaturation_of_countablyAdditivePart_eq_pi {𝓧 : Type*}
    [MeasurableSpace 𝓧] (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁] {S₁ : Set (Measure 𝓧)}
    (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P)
    (h : ∀ ν ∈ generalizedNullLaws S₁, ∀ k : ℕ, countablyAdditivePart (ν k) =
      Measure.pi fun _ : Fin (k + 1) ↦ (countablyAdditivePart (ν 0)).map (fun x ↦ x 0)) :
    bipolarRate Q₁ S₁ = ⨅ ν ∈ generalizedNullLaws S₁,
        klIntegral Q₁ ((countablyAdditivePart (ν 0)).map (fun x ↦ x 0)) ∧
      bipolarRate Q₁ S₁ = klInf Q₁ (iidSaturation S₁) := by
  sorry

/-- The infimum of `Φ` over the probability measures of a basic neighbourhood of `Q` for the
integrals of bounded measurable functions (Layer 6.1). -/
def nbhdInf (Φ : Measure Ω → EReal) (Q : Measure Ω) {k : ℕ} (g : Fin k → Ω → ℝ) (ε : ℝ) :
    EReal :=
  ⨅ (R : Measure Ω) (_ : IsProbabilityMeasure R)
    (_ : ∀ i, |∫ x, g i x ∂R - ∫ x, g i x ∂Q| ≤ ε), Φ R

/-- The neighbourhood envelope of `Φ` at `Q` (Layer 6.1): the supremum over the basic
neighbourhoods of `Q` of the infimum of `Φ` over them. -/
def tauEnvelope (Φ : Measure Ω → EReal) (Q : Measure Ω) : EReal :=
  ⨆ (k : ℕ) (g : Fin k → Ω → ℝ) (_ : ∀ i, Measurable (g i)) (_ : ∀ i, ∃ C, ∀ x, |g i x| ≤ C)
    (ε : ℝ) (_ : 0 < ε), nbhdInf Φ Q g ε

/-- The sequential envelope of `Φ` at `Q` (Layer 6.1): the infimum of `liminf Φ (R k)` over the
sequences of probability measures that converge to `Q` on every measurable set. -/
def seqTauEnvelope (Φ : Measure Ω → EReal) (Q : Measure Ω) : EReal :=
  ⨅ (R : ℕ → Measure Ω) (_ : ∀ k, IsProbabilityMeasure (R k))
    (_ : ∀ A, MeasurableSet A → Tendsto (fun k ↦ R k A) atTop (𝓝 (Q A))),
    liminf (fun k ↦ Φ (R k)) atTop

/-- The optimal growth rate is the supremum over `n` of the neighbourhood envelopes of the
smallest relative entropy to the `n`-sample null, divided by `n` (Layer 6.1) [EVR26, Note 15]. -/
theorem bipolarRate_eq_iSup_tauEnvelope_div {𝓧 : Type*} [MeasurableSpace 𝓧] (Q₁ : Measure 𝓧)
    [IsProbabilityMeasure Q₁] (S₁ : Set (Measure 𝓧)) (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P) :
    bipolarRate Q₁ S₁ = ⨆ n : ℕ, tauEnvelope (fun R ↦ klInf R (sampleNull S₁ (n + 1)))
      (Measure.pi fun _ : Fin (n + 1) ↦ Q₁) / ((n + 1 : ℕ) : EReal) := by
  sorry

/-- The optimal growth rate is at most the sequential envelope of the smallest relative entropy
(Layer 6.1) [EVR26, Note 19]. -/
theorem bipolarRate_le_seqTauEnvelope {𝓧 : Type*} [MeasurableSpace 𝓧] (Q₁ : Measure 𝓧)
    [IsProbabilityMeasure Q₁] (S₁ : Set (Measure 𝓧)) (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P) :
    bipolarRate Q₁ S₁ ≤ seqTauEnvelope (fun R ↦ klInf R S₁) Q₁ := by
  sorry

/-- The payoff of the bet `exp g` against `P`, under the alternative `Q` (Layer 6.1). -/
def gamePayoff (Q P : Measure Ω) (g : Ω → ℝ) : ℝ :=
  ∫ x, g x ∂Q - Real.log (∫ x, Real.exp (g x) ∂P)

/-- The max–min value of the game between bounded bets and a null is the largest expected
logarithm of an e-variable (Layer 6.1). -/
theorem iSup_iInf_gamePayoff_eq_maxEPower (Q : Measure Ω) [IsProbabilityMeasure Q]
    {T : Set (Measure Ω)} (hT : ∀ P ∈ T, IsProbabilityMeasure P) :
    ⨆ (g : Ω → ℝ) (_ : Measurable g) (_ : ∃ C, ∀ x, |g x| ≤ C),
      ⨅ P ∈ T, (gamePayoff Q P g : EReal) = maxEPower Q T := by
  sorry

/-- The min–max value of the game between bounded bets and a null is the smallest relative entropy
to the null (Layer 6.1). -/
theorem iInf_iSup_gamePayoff_eq_klInf (Q : Measure Ω) [IsProbabilityMeasure Q]
    {T : Set (Measure Ω)} (hT : ∀ P ∈ T, IsProbabilityMeasure P) :
    ⨅ P ∈ T, ⨆ (g : Ω → ℝ) (_ : Measurable g) (_ : ∃ C, ∀ x, |g x| ≤ C),
      (gamePayoff Q P g : EReal) = klInf Q T := by
  sorry

/-- The event that the average of each statistic `g i` over `m` observations is within `δ` of its
mean under `Q` (Layer 6.1). -/
def blockEvent (Q : Measure Ω) {k : ℕ} (g : Fin k → Ω → ℝ) (δ : ℝ) (m : ℕ) : Set (Fin m → Ω) :=
  {y | ∀ i, |(m : ℝ)⁻¹ * ∑ b, g i (y b) - ∫ x, g i x ∂Q| ≤ δ}

/-- The largest probability of `blockEvent Q g δ m` under the laws of `m` independent observations
with one law in `T` (Layer 6.1). -/
def blockUpperProb (T : Set (Measure Ω)) (Q : Measure Ω) {k : ℕ} (g : Fin k → Ω → ℝ) (δ : ℝ)
    (m : ℕ) : ℝ≥0∞ :=
  ⨆ P ∈ T, (Measure.pi fun _ : Fin m ↦ P) (blockEvent Q g δ m)

/-- The suprema over the basic neighbourhoods of the lower and of the upper exponents of the upper
probability of the empirical events are the neighbourhood envelope of the smallest relative
entropy to the null (Layer 6.1) [EVR26, Note 15]. -/
theorem iSup_liminf_limsup_neg_log_blockUpperProb_eq_tauEnvelope (Q : Measure Ω)
    {T : Set (Measure Ω)} (hT : ∀ P ∈ T, IsProbabilityMeasure P) :
    (⨆ (k : ℕ) (g : Fin k → Ω → ℝ) (_ : ∀ i, Measurable (g i))
        (_ : ∀ i, ∃ C, ∀ x, |g i x| ≤ C) (δ : ℝ) (_ : 0 < δ),
        liminf (fun m : ℕ ↦ ENNReal.log (blockUpperProb T Q g δ m)⁻¹ / (m : EReal)) atTop) =
        tauEnvelope (fun R ↦ klInf R T) Q ∧
      (⨆ (k : ℕ) (g : Fin k → Ω → ℝ) (_ : ∀ i, Measurable (g i))
        (_ : ∀ i, ∃ C, ∀ x, |g i x| ≤ C) (δ : ℝ) (_ : 0 < δ),
        limsup (fun m : ℕ ↦ ENNReal.log (blockUpperProb T Q g δ m)⁻¹ / (m : EReal)) atTop) =
        tauEnvelope (fun R ↦ klInf R T) Q := by
  sorry

/-- The optimal growth rate is the exponent of the upper probability under the null of the events
given by statistics of blocks of observations (Layer 6.1) [EVR26, Note 15]. -/
theorem iSup_liminf_neg_log_blockUpperProb_eq_bipolarRate {𝓧 : Type*} [MeasurableSpace 𝓧]
    (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁] (S₁ : Set (Measure 𝓧))
    (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P) :
    ⨆ (n : ℕ) (k : ℕ) (g : Fin k → (Fin (n + 1) → 𝓧) → ℝ) (_ : ∀ i, Measurable (g i))
        (_ : ∀ i, ∃ C, ∀ x, |g i x| ≤ C) (δ : ℝ) (_ : 0 < δ),
        liminf (fun m : ℕ ↦ ENNReal.log (blockUpperProb (sampleNull S₁ (n + 1))
          (Measure.pi fun _ : Fin (n + 1) ↦ Q₁) g δ m)⁻¹ / (((n + 1) * m : ℕ) : EReal)) atTop =
      bipolarRate Q₁ S₁ := by
  sorry

/-- **Tests between two nulls** (Layer 6.1) [EVR26, Note 32, Statement 1]. On a countable alphabet,
the members of `H₁` charging every point, the test that stops when an e-process for the i.i.d. null
of `H₀` reaches `α⁻¹` or a test supermartingale for the i.i.d. null of `H₁` reaches `β⁻¹` makes at
least `kl(1 - α, β) / a₁(Q, H₁)` observations in expectation under the i.i.d. law of every
`Q ∈ H₀`, with `kl` the relative entropy of Bernoulli laws. -/
theorem ofReal_kl_div_maxEPower_le_lintegral_min_hittingAfter {𝓧 : Type*} [MeasurableSpace 𝓧]
    [Countable 𝓧] [MeasurableSingletonClass 𝓧] {H₀ H₁ : Set (Measure 𝓧)}
    (hH₁ : ∀ P ∈ H₁, IsProbabilityMeasure P) (hpos : ∀ P ∈ H₁, ∀ x, P {x} ≠ 0)
    {M M' : ℕ → (ℕ → 𝓧) → ℝ≥0∞} (hM : IsEProcess M piLT (iidNull H₀))
    (hM' : IsTestSupermartingale M' piLT (iidNull H₁)) {α β : ℝ} (hα : α ∈ Ioo 0 1)
    (hβ : β ∈ Ioo 0 1) (hαβ : α + β ≤ 1) {Q : Measure 𝓧} [IsProbabilityMeasure Q] (hQ : Q ∈ H₀) :
    ENNReal.ofReal ((1 - α) * Real.log ((1 - α) / β) + α * Real.log (α / (1 - β))) /
        (maxEPower Q H₁).toENNReal ≤
      ∫⁻ ω, ENat.toENNReal (min (hittingAfter M (Ici (ENNReal.ofReal α)⁻¹) 0 ω)
        (hittingAfter M' (Ici (ENNReal.ofReal β)⁻¹) 0 ω)) ∂Measure.infinitePi (fun _ : ℕ ↦ Q) := by
  sorry

/-- The regret of the numeraire of the `n`-sample null against a mixture of i.i.d. laws
(Layer 6.1) [EVR26, Note 14, Theorem (1)]. -/
theorem maxLogGrowth_le_eintegral_log_numeraire_bind_add {𝓧 : Type*} [MeasurableSpace 𝓧]
    (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁] (S₁ : Set (Measure 𝓧))
    (hS₁ : ∀ P ∈ S₁, P univ ≤ 1) (ν : Measure (Measure 𝓧)) [IsProbabilityMeasure ν]
    (hν : ∀ᵐ Q' ∂ν, IsProbabilityMeasure Q') (n : ℕ) {B : Set (Measure 𝓧)} (hνB : ν B ≠ 0)
    (hKL : ∫⁻ Q' in B, klDiv Q₁ Q' ∂ν ≠ ⊤) :
    maxLogGrowth Q₁ S₁ n ≤
      ∫ᵉ x, ENNReal.log (numeraire (ν.bind fun Q' ↦ Measure.pi fun _ : Fin n ↦ Q')
        (sampleNull S₁ n) x) ∂Measure.pi (fun _ : Fin n ↦ Q₁) +
      ENNReal.log (ν B)⁻¹ + n * (((ν B)⁻¹ * ∫⁻ Q' in B, klDiv Q₁ Q' ∂ν : ℝ≥0∞) : EReal) := by
  sorry

/-- The time mixture of a sequence of `n`-sample e-variables, evaluated at the first `n`
observations (Layer 6.1). -/
def timeMixture {𝓧 : Type*} [MeasurableSpace 𝓧] (G : (n : ℕ) → (Fin n → 𝓧) → ℝ≥0∞) (n : ℕ)
    (ω : ℕ → 𝓧) : ℝ≥0∞ :=
  ∑ j ∈ Finset.Icc 1 n, G j (fun i ↦ ω i) / ((j : ℝ≥0∞) * (j + 1))

/-- The time mixture of the numeraires against a prior is an e-process for the i.i.d. null that
attains the optimal growth rate on the Kullback–Leibler support of the prior, on any measurable
space (Layer 6.1). -/
theorem isEProcess_timeMixture_and_ae_tendsto_log_div {𝓧 : Type*} [MeasurableSpace 𝓧]
    (Q₁ : Measure 𝓧) [IsProbabilityMeasure Q₁] (S₁ : Set (Measure 𝓧))
    (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P) (ν : Measure (Measure 𝓧)) [IsFiniteMeasure ν]
    (hν : ∀ᵐ Q' ∂ν, IsProbabilityMeasure Q')
    (hsupp : ∀ ε : ℝ≥0∞, 0 < ε → ν {Q' | klDiv Q₁ Q' ≤ ε} ≠ 0) :
    IsEProcess (timeMixture fun n ↦ numeraire (ν.bind fun Q' ↦ Measure.pi fun _ : Fin n ↦ Q')
        (sampleNull S₁ n)) piLT (iidNull S₁) ∧
      ∀ᵐ ω ∂Measure.infinitePi (fun _ : ℕ ↦ Q₁),
        Tendsto (fun n : ℕ ↦ ENNReal.log (timeMixture
          (fun n ↦ numeraire (ν.bind fun Q' ↦ Measure.pi fun _ : Fin n ↦ Q') (sampleNull S₁ n))
          n ω) / (n : EReal)) atTop (𝓝 (bipolarRate Q₁ S₁)) := by
  sorry

/-- A process attains the optimal growth rate on a class `𝒬` of alternatives when, under the
i.i.d. law of every probability measure of `𝒬`, `(1/n) log (E n)` tends to the rate almost surely
(Layer 6.1) [EVR26, Note 55]. -/
def AttainsBipolarRate {𝓧 : Type*} [MeasurableSpace 𝓧] (E : ℕ → (ℕ → 𝓧) → ℝ≥0∞)
    (S₁ 𝒬 : Set (Measure 𝓧)) : Prop :=
  ∀ (Q : Measure 𝓧) [IsProbabilityMeasure Q], Q ∈ 𝒬 →
    ∀ᵐ ω ∂Measure.infinitePi (fun _ : ℕ ↦ Q),
      Tendsto (fun n : ℕ ↦ ENNReal.log (E n ω) / (n : EReal)) atTop (𝓝 (bipolarRate Q S₁))

/-- **The classes on which one e-process attains the rate** (Layer 6.1) [EVR26, Note 55,
Proposition 1]: an e-process at the rate on `𝒬`, sample e-variables at the rate on `𝒬`, and a
countable family of bounded block bets that determines the rate on `𝒬` exist together. -/
theorem exists_attainsBipolarRate_tfae {𝓧 : Type*} [MeasurableSpace 𝓧] {S₁ : Set (Measure 𝓧)}
    (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P) (𝒬 : Set (Measure 𝓧)) :
    List.TFAE [
      ∃ E : ℕ → (ℕ → 𝓧) → ℝ≥0∞, IsEProcess E piLT (iidNull S₁) ∧ AttainsBipolarRate E S₁ 𝒬,
      ∃ M : (n : ℕ) → (Fin n → 𝓧) → ℝ≥0∞, (∀ n ≠ 0, IsEVar (M n) (sampleNull S₁ n)) ∧
        ∀ (Q : Measure 𝓧) [IsProbabilityMeasure Q], Q ∈ 𝒬 →
          ∀ᵐ ω ∂Measure.infinitePi (fun _ : ℕ ↦ Q), bipolarRate Q S₁ ≤
            liminf (fun n : ℕ ↦ ENNReal.log (M n fun i ↦ ω i) / (n : EReal)) atTop,
      ∃ (len : ℕ → ℕ) (g : (i : ℕ) → (Fin (len i) → 𝓧) → ℝ), (∀ i, 1 ≤ len i) ∧
        (∀ i, Measurable (g i)) ∧ (∀ i, ∃ C, ∀ x, |g i x| ≤ C) ∧
        (∀ i, IsEVar (fun x ↦ ENNReal.ofReal (Real.exp (g i x))) (sampleNull S₁ (len i))) ∧
        ∀ (Q : Measure 𝓧) [IsProbabilityMeasure Q], Q ∈ 𝒬 →
          ⨆ i, (((∫ x, g i x ∂Measure.pi (fun _ : Fin (len i) ↦ Q)) / len i : ℝ) : EReal) =
            bipolarRate Q S₁] := by
  sorry

/-- From a countable family of bounded block bets with the rate below the supremum of their
normalized means on a class `𝒬`, one nondecreasing e-process, valid at every random time, attains
the rate on `𝒬` almost surely and in expectation, and its tests attain the bound on expected
stopping times (Layers 6.1 and 6.3) [EVR26, Notes 13 and 55]. -/
theorem exists_isEProcess_monotone_attainsBipolarRate_of_le_iSup {𝓧 : Type*} [MeasurableSpace 𝓧]
    {S₁ : Set (Measure 𝓧)} (hS₁ : ∀ P ∈ S₁, IsProbabilityMeasure P) {𝒬 : Set (Measure 𝓧)}
    {len : ℕ → ℕ} {g : (i : ℕ) → (Fin (len i) → 𝓧) → ℝ} (hgb : ∀ i, ∃ C, ∀ x, |g i x| ≤ C)
    (hge : ∀ i, IsEVar (fun x ↦ ENNReal.ofReal (Real.exp (g i x))) (sampleNull S₁ (len i)))
    (hsup : ∀ (Q : Measure 𝓧) [IsProbabilityMeasure Q], Q ∈ 𝒬 → bipolarRate Q S₁ ≤
      ⨆ i, (((∫ x, g i x ∂Measure.pi (fun _ : Fin (len i) ↦ Q)) / len i : ℝ) : EReal)) :
    ∃ E : ℕ → (ℕ → 𝓧) → ℝ≥0∞, IsEProcess E piLT (iidNull S₁) ∧ Monotone E ∧
      IsEVar (fun ω ↦ ⨆ n, E n ω) (iidNull S₁) ∧ AttainsBipolarRate E S₁ 𝒬 ∧
      ∀ (Q : Measure 𝓧) [IsProbabilityMeasure Q], Q ∈ 𝒬 →
        Tendsto (fun n : ℕ ↦
            (∫ᵉ ω, ENNReal.log (E n ω) ∂Measure.infinitePi (fun _ : ℕ ↦ Q)) / (n : EReal))
          atTop (𝓝 (bipolarRate Q S₁)) ∧
        (∀ᵐ ω ∂Measure.infinitePi (fun _ : ℕ ↦ Q),
          Tendsto (fun α : ℝ≥0∞ ↦ ENat.toENNReal (hittingAfter E (Ici α⁻¹) 0 ω) /
              (ENNReal.log α⁻¹).toENNReal) (𝓝[>] 0) (𝓝 (bipolarRate Q S₁).toENNReal⁻¹)) ∧
        Tendsto (fun α : ℝ≥0∞ ↦
            (∫⁻ ω, ENat.toENNReal (hittingAfter E (Ici α⁻¹) 0 ω)
              ∂Measure.infinitePi (fun _ : ℕ ↦ Q)) / (ENNReal.log α⁻¹).toENNReal)
          (𝓝[>] 0) (𝓝 (bipolarRate Q S₁).toENNReal⁻¹) := by
  sorry

section Designs

variable {α 𝓨 : Type*} [Fintype α] [MeasurableSpace 𝓨]

/-- The largest expected logarithm, under the instance `μ`, of an e-variable for the null of the
instances `Λ`, with `n a` observations of source `a` (Layer 6.4). -/
def designValue (μ : α → Measure 𝓨) (Λ : Set (α → Measure 𝓨)) (n : α → ℕ) : EReal :=
  maxEPower (Measure.pi fun a ↦ Measure.pi fun _ : Fin (n a) ↦ μ a)
    ((fun l ↦ Measure.pi fun a ↦ Measure.pi fun _ : Fin (n a) ↦ l a) '' Λ)

/-- The rate `D*` of the designs at the instance `μ` against the instances `Λ` (Layer 6.4). -/
def designRate (μ : α → Measure 𝓨) (Λ : Set (α → Measure 𝓨)) : EReal :=
  ⨆ (n : α → ℕ) (_ : n ≠ 0), designValue μ Λ n / ((∑ a, n a : ℕ) : EReal)

/-- With one source, the rate of the designs is the optimal growth rate (Layer 6.4). -/
theorem designRate_unique [Unique α] (μ : α → Measure 𝓨) [∀ a, IsProbabilityMeasure (μ a)]
    (Λ : Set (α → Measure 𝓨)) (hΛ : ∀ l ∈ Λ, ∀ a, IsProbabilityMeasure (l a)) :
    designRate μ Λ = bipolarRate (μ default) ((fun l ↦ l default) '' Λ) := by
  sorry

end Designs

/-! ## Layer 7: merging e-values -/

/-- An e-merging function, defined through laws and not required to be monotone
[RW, Definition 8.1, Proposition A.3; Cle26]. -/
def IsEMerging {ι : Type*} [Fintype ι] (F : (ι → ℝ≥0∞) → ℝ≥0∞) : Prop :=
  Measurable F ∧ ∀ μ : Measure (ι → ℝ≥0∞), IsProbabilityMeasure μ →
    (∀ i, ∫⁻ e, e i ∂μ ≤ 1) → ∫⁻ e, F e ∂μ ≤ 1

/-- The null of the joint laws in `𝒞` of `ι` e-values: probability measures on `ι → ℝ≥0∞` whose
coordinates have mean at most one (Layer 7.1). -/
def mergingNull {ι : Type*} (𝒞 : Set (Measure (ι → ℝ≥0∞))) : Set (Measure (ι → ℝ≥0∞)) :=
  𝒞 ∩ {μ | IsProbabilityMeasure μ ∧ ∀ i, ∫⁻ e, e i ∂μ ≤ 1}

/-- A merging function is an e-variable for the null of the joint laws of e-values
(Layer 7.1). -/
theorem isEMerging_iff_isEVar_mergingNull {ι : Type*} [Fintype ι] {F : (ι → ℝ≥0∞) → ℝ≥0∞} :
    IsEMerging F ↔ IsEVar F (mergingNull univ) := by
  sorry

/-- Every e-merging function is dominated by a weighted mean [Wan25, Theorem 1; Cle26]. -/
theorem IsEMerging.exists_le_weightedMean {ι : Type*} [Fintype ι] {F : (ι → ℝ≥0∞) → ℝ≥0∞}
    (hF : IsEMerging F) :
    ∃ (w : ι → ℝ≥0∞) (w₀ : ℝ≥0∞), w₀ + ∑ i, w i = 1 ∧
      ∀ e : ι → ℝ≥0, F (fun i ↦ e i) ≤ w₀ + ∑ i, w i * e i := by
  sorry

/-- A merging function for exchangeable e-values (Layer 7.4): its integral is at most `1` against
every probability measure that is invariant under the permutations of the coordinates and whose
coordinates have expectation at most `1`. -/
def IsExchangeableEMerging {K : ℕ} (F : (Fin K → ℝ≥0∞) → ℝ≥0∞) : Prop :=
  Measurable F ∧ ∀ μ : Measure (Fin K → ℝ≥0∞), IsProbabilityMeasure μ →
    (∀ σ : Equiv.Perm (Fin K), μ.map (fun e ↦ e ∘ σ) = μ) → (∀ i, ∫⁻ e, e i ∂μ ≤ 1) →
    ∫⁻ e, F e ∂μ ≤ 1

/-- A measurable function is a merging function for exchangeable e-values exactly when its
symmetrization is at most a convex combination of `1` and the mean (Layer 7.4). -/
theorem isExchangeableEMerging_iff {K : ℕ} (F : (Fin K → ℝ≥0∞) → ℝ≥0∞) :
    IsExchangeableEMerging F ↔ Measurable F ∧ ∃ l : ℝ≥0∞, l ≤ 1 ∧ ∀ e : Fin K → ℝ≥0,
      (∑ σ : Equiv.Perm (Fin K), F fun i ↦ e (σ i)) / (K.factorial : ℝ≥0∞) ≤
        (1 - l) + l * ((∑ i, (e i : ℝ≥0∞)) / (K : ℝ≥0∞)) := by
  sorry

/-! ## Layer 8: multiple testing -/

section MultipleTesting

variable {ι : Type*} [Fintype ι]

/-- The true nulls under `P`. -/
def trueNulls (H : ι → Set (Measure Ω)) (P : Measure Ω) : Finset ι := by
  classical exact Finset.univ.filter fun i ↦ P ∈ H i

/-- The false discovery proportion of the rejections `R` when the true nulls are `N`. -/
def fdp [DecidableEq ι] (N R : Finset ι) : ℝ≥0∞ :=
  ((R ∩ N).card : ℝ≥0∞) / max (R.card : ℝ≥0∞) 1

/-- Compound e-variables for the nulls `H` [IWR, Definition 2.1; RW, Definition 9.1]. -/
def IsCompoundEVar (E : ι → Ω → ℝ≥0∞) (H : ι → Set (Measure Ω)) : Prop :=
  (∀ i, Measurable (E i)) ∧ ∀ P : Measure Ω, IsProbabilityMeasure P →
    ∑ i ∈ trueNulls H P, ∫⁻ ω, E i ω ∂P ≤ Fintype.card ι

/-- Self-consistent rejection sets control the false discovery rate under arbitrary dependence
[RW, Theorem 9.11; WR22, Proposition 2]. -/
theorem lintegral_fdp_le_of_selfConsistent [DecidableEq ι] {E : ι → Ω → ℝ≥0∞}
    {H : ι → Set (Measure Ω)} (hE : IsCompoundEVar E H) {α : ℝ≥0∞} {R : Ω → Finset ι}
    (hR_meas : ∀ i, MeasurableSet {ω | i ∈ R ω})
    (hR : ∀ ω, ∀ i ∈ R ω, (Fintype.card ι : ℝ≥0∞) ≤ α * (R ω).card * E i ω)
    (P : Measure Ω) [IsProbabilityMeasure P] :
    ∫⁻ ω, fdp (trueNulls H P) (R ω) ∂P ≤ α := by
  sorry

/-- An e-collection [XSF+26, Definition 5]. -/
def IsECollection (e : Finset ι → Ω → ℝ≥0∞) (H : ι → Set (Measure Ω)) : Prop :=
  (∀ S, Measurable (e S)) ∧ (∀ ω, e ∅ ω = 0) ∧
    ∀ P : Measure Ω, IsProbabilityMeasure P → ∫⁻ ω, e (trueNulls H P) ω ∂P ≤ 1

/-- An e-collection is a family of e-variables indexed by the set of true hypotheses
(Layer 8.2). -/
theorem isECollection_iff (e : Finset ι → Ω → ℝ≥0∞) (H : ι → Set (Measure Ω)) :
    IsECollection e H ↔ (∀ ω, e ∅ ω = 0) ∧
      ∀ N, IsEVar (e N) {P | IsProbabilityMeasure P ∧ trueNulls H P = N} := by
  sorry

/-- The e-Closure Principle [XSF+26, Theorem 6]. -/
theorem eClosure (H : ι → Set (Measure Ω)) (f : Finset ι → Finset ι → ℝ≥0∞)
    (hf₁ : ∀ N, f N ∅ = 0) (hf₂ : ∀ R, f ∅ R = 0) (𝓡 : Ω → Set (Finset ι))
    (h𝓡 : ∀ R, MeasurableSet {ω | R ∈ 𝓡 ω}) {α : ℝ≥0∞} (hα0 : α ≠ 0) (hα : α ≠ ⊤) :
    (∀ P : Measure Ω, IsProbabilityMeasure P →
        ∫⁻ ω, ⨆ R ∈ 𝓡 ω, f (trueNulls H P) R ∂P ≤ α) ↔
      ∃ e, IsECollection e H ∧ ∀ ω, 𝓡 ω ⊆ {R | ∀ S, f S R ≤ α * e S ω} := by
  sorry

end MultipleTesting

/-! ## Layer 9: change detection -/

/-- An e-detector for a pre-change null [SRR24, Definition 2.2]. -/
def IsEDetector (M : ℕ → Ω → ℝ≥0∞) (ℱ : Filtration ℕ mΩ) (S : Set (Measure Ω)) : Prop :=
  (∀ n, Measurable[ℱ n] (M n)) ∧ ∀ P ∈ S, ∀ τ : Ω → ℕ,
    IsStoppingTime ℱ (fun ω ↦ (τ ω : WithTop ℕ)) →
      ∫⁻ ω, M (τ ω) ω ∂P ≤ ∫⁻ ω, (τ ω : ℝ≥0∞) ∂P

/-- The average run length of an e-detector is at least `α⁻¹` [SRR24, Theorem 2.4]. -/
theorem IsEDetector.inv_le_lintegral_hittingAfter {M : ℕ → Ω → ℝ≥0∞}
    (hM : IsEDetector M ℱ S) {P : Measure Ω} (hP : P ∈ S) [IsProbabilityMeasure P]
    (α : ℝ≥0∞) :
    α⁻¹ ≤ ∫⁻ ω, ENat.toENNReal (hittingAfter M (Ici α⁻¹) 0 ω) ∂P := by
  sorry

end LMLRoadmaps.EValues
